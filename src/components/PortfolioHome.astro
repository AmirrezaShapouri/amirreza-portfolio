---
interface Props { lang: "en" | "fa"; }
const { lang } = Astro.props;
const fa = lang === "fa";
const copy = fa ? {
  role: "توسعه‌دهنده بک‌اند و سازنده محصولات دیجیتال",
  intro: "من امیررضا شاپوری هستم؛ روی ساخت سیستم‌های بک‌اند، وب‌اپلیکیشن‌ها و محصولات SaaS تمرکز دارم.",
  headlineA: "ایده‌ها را به",
  headlineB: "محصولات دیجیتال",
  headlineC: "قابل استفاده تبدیل می‌کنم.",
  description: "از طراحی ساختار فنی تا پیاده‌سازی قابلیت‌های اصلی، تلاش می‌کنم نرم‌افزارهایی بسازم که مسئله‌ای واقعی را حل کنند؛ با معماری روشن، تجربه کاربری قابل فهم و کدی قابل نگهداری.",
  projects: "پروژه‌های منتخب", projectsSub: "از مسئله تا محصول",
  skills: "مهارت‌ها و ابزارها", skillsSub: "ابزارهایی که برای ساخت محصولات وب استفاده می‌کنم",
  about: "درباره من", aboutTitle: "تمرکز روی ساخت، یادگیری و بهتر کردن جزئیات",
  aboutText: "علاقه‌مند به مهندسی بک‌اند و تبدیل نیازهای واقعی به نرم‌افزارم. در پروژه‌هایم سعی می‌کنم فقط به پیاده‌سازی یک قابلیت فکر نکنم؛ بلکه ساختار داده، منطق کسب‌وکار، امنیت، نگهداری و تجربه استفاده را در کنار هم ببینم.",
  process: "روش کار", processSub: "یک مسیر روشن برای تبدیل نیاز به نرم‌افزار",
  services: "زمینه‌های همکاری", contact: "بیایید درباره ایده‌تان صحبت کنیم",
  contactText: "اگر برای ساخت یک وب‌اپلیکیشن، توسعه بک‌اند یا تبدیل یک فرایند به محصول نرم‌افزاری برنامه‌ای دارید، خوشحال می‌شوم گفتگو کنیم.",
  view: "مشاهده پروژه", inProgress: "در حال توسعه", live: "منتشر شده",
  github: "مشاهده GitHub", explore: "دیدن پروژه‌ها", aboutMe: "بیشتر درباره من",
  skillsGroups: [
    { title: "Backend", items: ["Python", "Django", "REST API", "Authentication", "Business Logic"] },
    { title: "Data & Infrastructure", items: ["PostgreSQL", "Database Design", "Redis (Learning)", "Linux (Learning)"] },
    { title: "Frontend", items: ["HTML", "CSS", "JavaScript", "TypeScript", "Astro", "Tailwind CSS"] },
    { title: "Workflow", items: ["Git", "GitHub", "Debugging", "Deployment", "Technical Documentation"] }
  ],
  steps: [
    { n: "01", title: "شناخت مسئله", body: "نیازها، کاربران و جریان اصلی کار را مشخص می‌کنم." },
    { n: "02", title: "طراحی راه‌حل", body: "ساختار داده، معماری و محدوده نسخه اولیه را تعریف می‌کنم." },
    { n: "03", title: "ساخت و بهبود", body: "قابلیت‌ها را پیاده‌سازی، بررسی و مرحله‌به‌مرحله بهتر می‌کنم." }
  ],
  servicesList: [
    { title: "توسعه بک‌اند", body: "طراحی منطق سمت سرور، مدل داده و قابلیت‌های اصلی محصول." },
    { title: "توسعه API", body: "ساخت APIهای منظم برای ارتباط میان سرویس‌ها و رابط کاربری." },
    { title: "وب‌اپلیکیشن", body: "پیاده‌سازی سامانه‌های تحت وب متناسب با نیاز کسب‌وکار." },
    { title: "محصولات SaaS", body: "طراحی و توسعه قابلیت‌های چندمستاجری و مدیریت اشتراک." }
  ]
} : {
  role: "Backend Developer & Digital Product Builder",
  intro: "I'm Amirreza Shapouri. I focus on building backend systems, web applications, and SaaS products.",
  headlineA: "Turning ideas into",
  headlineB: "digital products",
  headlineC: "built for real use.",
  description: "From technical foundations to core product features, I aim to build software that solves real problems—with clear architecture, thoughtful user experience, and maintainable code.",
  projects: "Selected projects", projectsSub: "From problem to product",
  skills: "Skills & toolkit", skillsSub: "Technologies and practices I use to build web products",
  about: "A little about me", aboutTitle: "Focused on building, learning, and the details",
  aboutText: "I'm interested in backend engineering and turning practical needs into software. I try to look beyond implementing an isolated feature and consider data structure, business logic, security, maintainability, and the overall user experience together.",
  process: "How I work", processSub: "A clear path from a real need to working software",
  services: "What I can help build", contact: "Have a product idea in mind?",
  contactText: "If you're planning a web application, need backend development, or want to turn a process into a software product, let's start a conversation.",
  view: "Visit project", inProgress: "In development", live: "Live",
  github: "Explore GitHub", explore: "Explore projects", aboutMe: "More about me",
  skillsGroups: [
    { title: "Backend", items: ["Python", "Django", "REST API", "Authentication", "Business Logic"] },
    { title: "Data & infrastructure", items: ["PostgreSQL", "Database Design", "Redis (Learning)", "Linux (Learning)"] },
    { title: "Frontend", items: ["HTML", "CSS", "JavaScript", "TypeScript", "Astro", "Tailwind CSS"] },
    { title: "Workflow", items: ["Git", "GitHub", "Debugging", "Deployment", "Technical Documentation"] }
  ],
  steps: [
    { n: "01", title: "Understand the problem", body: "Clarify the needs, users, and the core workflow." },
    { n: "02", title: "Shape the solution", body: "Define the data model, architecture, and first release scope." },
    { n: "03", title: "Build and refine", body: "Implement, review, and improve the product step by step." }
  ],
  servicesList: [
    { title: "Backend development", body: "Server-side logic, data models, and core product capabilities." },
    { title: "API development", body: "Well-structured APIs connecting services and user interfaces." },
    { title: "Web applications", body: "Purpose-built web systems shaped around business needs." },
    { title: "SaaS products", body: "Multi-tenant foundations and subscription-based product features." }
  ]
};
const projects = fa ? [
  { number: "01", type: "WEB DEVELOPMENT", name: "ElvoWood", status: copy.live, title: "کاتالوگ دیجیتال محصولات چوبی", body: "وب‌سایتی برای معرفی محصولات و نمایش ساختارمند کاتالوگ یک برند مبلمان چوبی؛ با تمرکز بر ارائه ساده و منظم محتوا.", tags: ["Django", "Python", "PostgreSQL"], href: "https://elvowood.ir/", action: copy.view, visual: "wood" },
  { number: "02", type: "SAAS PLATFORM", name: "Gym Management SaaS", status: copy.inProgress, title: "سامانه مدیریت باشگاه‌های ورزشی", body: "پلتفرمی چندباشگاهی برای مدیریت اعضا، پلن‌ها و اشتراک‌ها، حضور و غیاب، کارکنان و امور مالی. پروژه همچنان در حال توسعه است.", tags: ["Django", "PostgreSQL", "SaaS"], href: "", action: "مطالعه موردی به‌زودی", visual: "dashboard" }
] : [
  { number: "01", type: "WEB DEVELOPMENT", name: "ElvoWood", status: copy.live, title: "A digital catalog for a furniture brand", body: "A website built to present products and organize a wooden furniture brand's catalog, with a focus on clear and structured content.", tags: ["Django", "Python", "PostgreSQL"], href: "https://elvowood.ir/", action: copy.view, visual: "wood" },
  { number: "02", type: "SAAS PLATFORM", name: "Gym Management SaaS", status: copy.inProgress, title: "A multi-gym management platform", body: "A multi-tenant platform for members, plans and subscriptions, attendance, staff, and financial workflows. The product is actively in development.", tags: ["Django", "PostgreSQL", "SaaS"], href: "", action: "Case study coming soon", visual: "dashboard" }
];
---
<main class="site-shell relative overflow-hidden">
  <div class="ambient ambient-one" aria-hidden="true"></div>
  <div class="ambient ambient-two" aria-hidden="true"></div>
  <header class="site-header relative z-20 mx-auto flex max-w-7xl items-center justify-between px-5 py-5 sm:px-8">
    <a href={fa ? "/fa/" : "/en/"} class="brand flex items-center gap-3" aria-label="Amirreza Shapouri home">
      <span class="brand-mark">AS<span>.</span></span>
      <span class="brand-name">Amirreza Shapouri</span>
    </a>
    <nav class="hidden items-center gap-7 text-sm md:flex" aria-label={fa ? "ناوبری اصلی" : "Main navigation"}>
      <a href="#projects">{copy.projects}</a><a href="#skills">{copy.skills}</a><a href="#about">{copy.about}</a><a href="#contact">{fa ? "ارتباط" : "Contact"}</a>
    </nav>
    <div class="flex items-center gap-3">
      <a class="language-switch" href={fa ? "/en/" : "/fa/"} lang={fa ? "en" : "fa"}>{fa ? "EN" : "FA"}</a>
      <a class="header-cta hidden sm:inline-flex" href="#contact">{fa ? "شروع گفتگو" : "Let's talk"} <span>↗</span></a>
    </div>
  </header>

  <section class="hero relative z-10 mx-auto grid max-w-7xl items-center gap-14 px-5 pb-24 pt-16 sm:px-8 lg:grid-cols-[1.05fr_.95fr] lg:pb-32 lg:pt-24">
    <div class="hero-copy">
      <div class="eyebrow"><span class="status-dot"></span>{copy.role}</div>
      <h1 class="hero-title">{copy.headlineA}<br /><span>{copy.headlineB}</span><br />{copy.headlineC}</h1>
      <p class="hero-intro">{copy.intro}</p>
      <p class="hero-description">{copy.description}</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a class="button-primary" href="#projects">{copy.explore}<span>↗</span></a>
        <a class="button-secondary" href="#about">{copy.aboutMe}</a>
      </div>
      <div class="hero-meta">
        <span><i></i> Python & Django</span><span><i></i> Product-minded</span><span><i></i> Always learning</span>
      </div>
    </div>
    <div class="hero-art" aria-label="Code-inspired visual">
      <div class="orbit orbit-a"></div><div class="orbit orbit-b"></div>
      <div class="code-window">
        <div class="window-bar"><div class="window-dots"><i></i><i></i><i></i></div><span>product.py</span><span class="window-menu">•••</span></div>
        <div class="code-content">
          <div class="code-line"><span class="ln">01</span><span><b>class</b> <strong>Product</strong>:</span></div>
          <div class="code-line"><span class="ln">02</span><span class="indent"><b>def</b> <em>__init__</em>(self, idea):</span></div>
          <div class="code-line"><span class="ln">03</span><span class="indent2">self.idea = idea</span></div>
          <div class="code-line"><span class="ln">04</span><span></span></div>
          <div class="code-line"><span class="ln">05</span><span class="indent"><b>def</b> <em>solve</em>(self, problem):</span></div>
          <div class="code-line"><span class="ln">06</span><span class="indent2"><i>return</i> <u>"something useful"</u></span></div>
          <div class="code-line"><span class="ln">07</span><span></span></div>
          <div class="code-line"><span class="ln">08</span><span class="comment"># Build with purpose.</span></div>
        </div>
        <div class="window-footer"><span><b></b> Python 3</span><span>main <small>●</small></span></div>
      </div>
      <div class="floating-chip chip-top"><span>✳</span> Thoughtful engineering</div>
      <div class="floating-chip chip-bottom"><span>⌘</span> Ideas → Products</div>
      <div class="hero-index"><span>01</span><span class="index-line"></span><span>PORTFOLIO</span></div>
    </div>
  </section>

  <div class="ticker-wrap" aria-label="Areas of focus"><div class="ticker-track"><span>BACKEND ENGINEERING</span><b>✳</b><span>SAAS PRODUCTS</span><b>✳</b><span>WEB APPLICATIONS</span><b>✳</b><span>DATABASE DESIGN</span><b>✳</b><span>BACKEND ENGINEERING</span><b>✳</b><span>SAAS PRODUCTS</span><b>✳</b><span>WEB APPLICATIONS</span><b>✳</b><span>DATABASE DESIGN</span><b>✳</b></div></div>

  <section id="projects" class="section-wrap mx-auto max-w-7xl scroll-mt-20 px-5 py-24 sm:px-8">
    <div class="section-heading"><div><p class="section-kicker">01 / {copy.projects}</p><h2>{copy.projectsSub}</h2></div><p>{fa ? "پروژه‌هایی که از دل نیازهای واقعی شکل گرفته‌اند." : "A closer look at products shaped around practical needs."}</p></div>
    <div class="project-grid mt-12">
      {projects.map((project) => <article class="project-card">
        <div class:list={["project-visual", project.visual]}>
          <div class="visual-top"><span>{project.type}</span><span>{project.number} / 02</span></div>
          {project.visual === "wood" ? <div class="wood-preview"><div class="wood-sun"></div><div class="wood-panel panel-one"></div><div class="wood-panel panel-two"></div><div class="wood-caption">ELVO<span>WOOD</span></div><div class="wood-subtitle">CRAFTED FOR LIVING</div></div> : <div class="dashboard-preview"><div class="dash-side"><i></i><i></i><i></i><i></i></div><div class="dash-main"><div class="dash-title"></div><div class="dash-stats"><i></i><i></i><i></i></div><div class="dash-chart"><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div><div class="dash-rows"><i></i><i></i><i></i></div></div></div>}
          <span class="visual-glow"></span>
        </div>
        <div class="project-info">
          <div class="project-status"><span class:list={["status-pill", project.visual === "wood" ? "status-live" : "status-progress"]}>{project.status}</span><span class="project-type">{project.type}</span></div>
          <h3>{project.name}</h3><h4>{project.title}</h4><p>{project.body}</p>
          <div class="tag-list">{project.tags.map(tag => <span>{tag}</span>)}</div>
          {project.href ? <a class="text-link" href={project.href} target="_blank" rel="noreferrer">{project.action}<span>↗</span></a> : <span class="coming-soon">{project.action}</span>}
        </div>
      </article>)}
    </div>
  </section>

  <section id="skills" class="section-wrap skills-section scroll-mt-20 px-5 py-24 sm:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="section-heading"><div><p class="section-kicker">02 / {copy.skills}</p><h2>{copy.skillsSub}</h2></div><span class="section-mark">TOOLKIT <b>✳</b></span></div>
      <div class="skills-grid mt-12">{copy.skillsGroups.map((group, index) => <article class="skill-card"><div class="skill-card-head"><span>0{index + 1}</span><h3>{group.title}</h3></div><div class="skill-tags">{group.items.map(item => <span>{item}</span>)}</div></article>)}</div>
      <p class="skills-note">{fa ? "این فهرست تصویری از ابزارها و حوزه‌های فعلی من است؛ نه ادعای تسلط یکسان بر همه آن‌ها." : "This is a snapshot of my current toolkit—not a claim of equal expertise across every technology."}</p>
    </div>
  </section>

  <section id="about" class="section-wrap mx-auto grid max-w-7xl scroll-mt-20 gap-14 px-5 py-24 sm:px-8 lg:grid-cols-[.8fr_1.2fr]">
    <div class="about-aside"><p class="section-kicker">03 / {copy.about}</p><div class="about-monogram">AS<span>.</span></div><p class="about-caption">{fa ? "ساختن. آزمودن. بهتر کردن." : "Build. Learn. Improve."}</p></div>
    <div class="about-main"><p class="section-kicker">{fa ? "رویکرد من" : "MY APPROACH"}</p><h2>{copy.aboutTitle}</h2><p class="about-body">{copy.aboutText}</p><div class="principles"><div><span>01</span><b>{fa ? "ساختار روشن" : "Clear structure"}</b></div><div><span>02</span><b>{fa ? "حل مسئله" : "Problem solving"}</b></div><div><span>03</span><b>{fa ? "یادگیری مستمر" : "Continuous learning"}</b></div></div><a class="text-link" href="https://github.com/AmirrezaShapouri" target="_blank" rel="noreferrer">{copy.github}<span>↗</span></a></div>
  </section>

  <section class="process-section px-5 py-24 sm:px-8">
    <div class="mx-auto max-w-7xl"><div class="section-heading"><div><p class="section-kicker">04 / {copy.process}</p><h2>{copy.processSub}</h2></div><span class="section-mark">THINK → BUILD → REFINE</span></div><div class="process-grid mt-12">{copy.steps.map(step => <article class="process-card"><span class="process-number">{step.n}</span><h3>{step.title}</h3><p>{step.body}</p><span class="process-arrow">↗</span></article>)}</div></div>
  </section>

  <section class="section-wrap mx-auto max-w-7xl px-5 py-24 sm:px-8">
    <div class="section-heading"><div><p class="section-kicker">05 / {copy.services}</p><h2>{fa ? "از ایده تا پیاده‌سازی" : "From idea to implementation"}</h2></div><p>{fa ? "تمرکز بر توسعه محصولات وب و زیرساخت فنی آن‌ها." : "Focused on building web products and the systems behind them."}</p></div>
    <div class="services-grid mt-12">{copy.servicesList.map((service, index) => <article class="service-card"><span>0{index + 1}</span><div><h3>{service.title}</h3><p>{service.body}</p></div><b>↗</b></article>)}</div>
  </section>

  <section id="contact" class="contact-section mx-auto max-w-7xl scroll-mt-20 px-5 pb-20 sm:px-8">
    <div class="contact-panel"><div class="contact-orb"></div><div class="relative z-10"><p class="section-kicker">06 / CONTACT</p><h2>{copy.contact}</h2><p>{copy.contactText}</p><div class="mt-8 flex flex-wrap gap-3"><a class="button-primary" href="https://github.com/AmirrezaShapouri" target="_blank" rel="noreferrer">{copy.github}<span>↗</span></a><a class="button-secondary" href="https://www.linkedin.com/" target="_blank" rel="noreferrer">LinkedIn ↗</a></div></div><div class="contact-decoration" aria-hidden="true">AS<span>.</span></div></div>
  </section>

  <footer class="site-footer mx-auto flex max-w-7xl flex-col gap-4 px-5 py-8 sm:flex-row sm:items-center sm:justify-between sm:px-8"><a href={fa ? "/fa/" : "/en/"} class="footer-brand">Amirreza Shapouri<span>.</span></a><span>© {new Date().getFullYear()} {fa ? "تمامی حقوق محفوظ است." : "All rights reserved."}</span><span>{fa ? "ساخته‌شده با دقت و هدف" : "Designed with intent. Built with purpose."}</span></footer>
</main>
